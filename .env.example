# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Writing analysis (Google Gemini) — optional; mock fallback exists
GOOGLE_AI_API_KEY=

# Speaking live — local Ollama by default (no API key required)
SPEAKING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_SPEAKING_MODEL=gemma4:e4b

# Optional cloud speaking providers (set SPEAKING_PROVIDER to openai|gemini)
# OPENAI_API_KEY=
# OPENAI_SPEAKING_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_SPEAKING_MODEL=gemini-2.0-flash

# Local TTS — Kyutai pocket-tts by default (no API key, runs on CPU)
# Install once: uv tool install pocket-tts   (or: pip install pocket-tts)
# Run the voice server: npm run tts:pocket
TTS_PROVIDER=pocket
TTS_POCKET_URL=http://127.0.0.1:8765
TTS_POCKET_VOICE=marius
# Other English voices: alba, anna, vera, jean, charles, paul, george, michael, mary, jane, eve, ...

# Piper is used as the fallback when pocket-tts is not running
TTS_PIPER_MODEL=models/tts/en_US-ryan-high.onnx
# TTS_PIPER_BIN=/Users/YOU/Library/Python/3.11/bin/piper
# Other Piper voices:
# TTS_PIPER_MODEL=models/tts/en_US-danny-low.onnx   # male alt
# TTS_PIPER_MODEL=models/tts/en_US-lessac-low.onnx  # female
# Fallback without Piper on macOS:
# TTS_PROVIDER=macos
# TTS_MACOS_VOICE=Eddy
# Optional cloud TTS later:
# TTS_PROVIDER=openai
# TTS_OPENAI_MODEL=gpt-4o-mini-tts
# TTS_OPENAI_VOICE=alloy

# ── Cost controls ──
# Content bank: practice content is generated once (npm run content:generate) and
# reused for everyone. The model is only called when a user has seen everything.
# Set to "never" in production to serve only the bank + built-in content.
# CONTENT_LIVE_AI=never
# Save live generations into content/bank (default: on in dev, off in production)
# CONTENT_BANK_AUTOSAVE=0

# Speech cache: identical text + voice is synthesized once (default 500 MB, 0 = off)
# TTS_CACHE_DIR=.cache/tts
# TTS_CACHE_MAX_MB=500

# Daily AI limits per device/IP come from the plan (src/lib/plans.ts).
# Enforced in production by default; 1 = enforce everywhere, 0 = never.
# In-memory counters: fine for one server, use Redis/Supabase for several.
# QUOTA_ENFORCE=
